<% if (typeof records === "undefined") { %>
  <article class="rounded-2xl border border-orange-100 bg-white p-5 shadow-sm"><div class="flex items-center justify-between"><span class="text-sm font-medium text-slate-500">Restaurants</span><span class="text-lg" aria-hidden="true">🍽️</span></div><p class="mt-4 text-3xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p><p class="mt-1 text-xs text-slate-500">Partner restaurants</p></article>
<% } else { %>
  <section class="space-y-5">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Total restaurants</p><p class="mt-1 text-2xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p></div>
    <details class="group rounded-2xl border border-slate-200 bg-white shadow-sm">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 font-semibold text-slate-800"><span>Add restaurant</span><span class="rounded-lg bg-emerald-700 px-3 py-2 text-sm font-semibold text-white">+ New restaurant</span></summary>
      <form class="grid gap-4 border-t border-slate-100 p-5 sm:grid-cols-2 lg:grid-cols-3" data-api-endpoint="/api/restaurants" data-edit-endpoint="/api/restaurants" data-entity="restaurant">
        <label class="text-sm font-medium text-slate-700">Restaurant name<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="name" required placeholder="Restaurant name"></label>
        <label class="text-sm font-medium text-slate-700">Owner name<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="ownerName" required placeholder="Owner name"></label>
        <label class="text-sm font-medium text-slate-700">Email<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="email" type="email" required placeholder="owner@example.com"></label>
        <label class="text-sm font-medium text-slate-700">Phone<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="phone" type="tel" required placeholder="+91 98765 43210"></label>
        <label class="text-sm font-medium text-slate-700">City<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="city" required placeholder="City"></label>
        <label class="text-sm font-medium text-slate-700">Rating<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="rating" type="number" min="0" max="5" step="0.1" value="0"></label>
        <label class="text-sm font-medium text-slate-700">Status<select class="mt-1.5 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 font-normal" name="isActive"><option value="true">Active</option><option value="false">Inactive</option></select></label>
        <label class="text-sm font-medium text-slate-700 sm:col-span-2 lg:col-span-3">Address<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="address" required placeholder="Full restaurant address"></label>
        <label class="text-sm font-medium text-slate-700 sm:col-span-2 lg:col-span-3">Description<textarea class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="description" rows="2" placeholder="Short description"></textarea></label>
        <label class="text-sm font-medium text-slate-700 sm:col-span-2 lg:col-span-3">Restaurant image URL<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="image" type="url" placeholder="https://example.com/restaurant.jpg" data-image-url><img class="mt-3 hidden h-24 w-36 rounded-lg border border-slate-200 object-cover" alt="Restaurant image preview" data-image-preview></label>
        <div class="flex gap-3 sm:col-span-2 lg:col-span-3"><button class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white" type="submit">Save restaurant</button><button class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700" type="button" data-cancel-edit hidden>Cancel edit</button></div>
      </form>
    </details>
    <form method="get" action="/" data-auto-filter class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-5">
      <input type="hidden" name="page" value="restaurants">
      <label class="text-sm font-medium text-slate-700">Search<input class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal" type="search" name="search" value="<%= filters.search %>" placeholder="Restaurant, owner, email" data-filter-search></label>
      <label class="text-sm font-medium text-slate-700">City filter<input class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal" name="city" value="<%= filters.city %>" placeholder="City"></label>
      <label class="text-sm font-medium text-slate-700">Status<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="status"><option value="">All statuses</option><option value="active" <%= filters.status === "active" ? "selected" : "" %>>Active</option><option value="inactive" <%= filters.status === "inactive" ? "selected" : "" %>>Inactive</option></select></label>
      <label class="text-sm font-medium text-slate-700">Sort by<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="sort"><option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Newest</option><option value="oldest" <%= filters.sort === "oldest" ? "selected" : "" %>>Oldest</option><option value="name" <%= filters.sort === "name" ? "selected" : "" %>>Name A–Z</option><option value="rating" <%= filters.sort === "rating" ? "selected" : "" %>>Highest rated</option></select></label>
    </form>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto">
      <table class="w-full min-w-[700px] text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Restaurant</th><th class="px-5 py-3">Owner</th><th class="px-5 py-3">City</th><th class="px-5 py-3">Rating</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Actions</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% if (records.length) { records.forEach((restaurant) => { %>
            <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><% if (restaurant.image) { %><img class="h-12 w-16 rounded-lg object-cover" src="<%= restaurant.image %>" alt="<%= restaurant.name %>" loading="lazy"><% } else { %><span class="flex h-12 w-16 items-center justify-center rounded-lg bg-orange-50 text-xl" aria-hidden="true">🍽️</span><% } %><div><p class="font-semibold text-slate-800"><%= restaurant.name %></p><p class="mt-1 text-xs text-slate-500"><%= restaurant.email %></p></div></div></td><td class="px-5 py-4 text-slate-600"><%= restaurant.ownerName %></td><td class="px-5 py-4 text-slate-600"><%= restaurant.city %></td><td class="px-5 py-4 text-slate-600">★ <%= Number(restaurant.rating || 0).toFixed(1) %></td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-medium <%= restaurant.isActive ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>"><%= restaurant.isActive ? "Active" : "Inactive" %></span></td><td class="px-5 py-4 text-right"><button class="font-medium text-emerald-700" type="button" data-edit-record="<%= encodeURIComponent(JSON.stringify(restaurant)) %>">Edit</button><button class="ml-3 font-medium text-rose-600" type="button" data-delete-endpoint="/api/restaurants/<%= restaurant._id %>">Delete</button></td></tr>
          <% }); } else { %><tr><td class="px-5 py-10 text-center text-slate-500" colspan="6">No restaurants found yet.</td></tr><% } %>
        </tbody>
      </table>
    </div></div>
  </section>
<% } %>
