<% if (typeof records === "undefined") { %>
  <article class="rounded-2xl border border-rose-100 bg-white p-5 shadow-sm"><div class="flex items-center justify-between"><span class="text-sm font-medium text-slate-500">Menu items</span><span class="text-lg" aria-hidden="true">🍜</span></div><p class="mt-4 text-3xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p><p class="mt-1 text-xs text-slate-500">Available food items</p></article>
<% } else { %>
  <section class="space-y-5">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Total menu items</p><p class="mt-1 text-2xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p></div>
    <details class="group rounded-2xl border border-slate-200 bg-white shadow-sm">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 font-semibold text-slate-800"><span>Add food item</span><span class="rounded-lg bg-emerald-700 px-3 py-2 text-sm font-semibold text-white">+ New food item</span></summary>
      <form class="grid gap-4 border-t border-slate-100 p-5 sm:grid-cols-2 lg:grid-cols-3" data-api-endpoint="/api/foods" data-edit-endpoint="/api/foods" data-entity="food">
        <label class="text-sm font-medium text-slate-700">Food name<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="title" required placeholder="Menu item name"></label>
        <label class="text-sm font-medium text-slate-700">Restaurant<select class="mt-1.5 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 font-normal" name="restaurantId" required><option value="">Select restaurant</option><% restaurantsForSelect.forEach((restaurant) => { %><option value="<%= restaurant._id %>"><%= restaurant.name %></option><% }); %></select></label>
        <label class="text-sm font-medium text-slate-700">Price (₹)<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="price" type="number" min="0" step="0.01" required placeholder="0.00"></label>
        <label class="text-sm font-medium text-slate-700">Food image URL<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="image" type="url" placeholder="https://example.com/food.jpg" data-image-url><img class="mt-3 hidden h-20 w-28 rounded-lg border border-slate-200 object-cover" alt="Food image preview" data-image-preview></label>
        <label class="text-sm font-medium text-slate-700">Rating<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="rating" type="number" min="0" max="5" step="0.1" value="0"></label>
        <label class="text-sm font-medium text-slate-700">Availability<select class="mt-1.5 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 font-normal" name="isAvailable"><option value="true">Available</option><option value="false">Unavailable</option></select></label>
        <label class="text-sm font-medium text-slate-700 sm:col-span-2 lg:col-span-3">Description<textarea class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="description" rows="2" placeholder="Describe this menu item"></textarea></label>
        <div class="flex gap-3 sm:col-span-2 lg:col-span-3"><button class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white" type="submit">Save food item</button><button class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700" type="button" data-cancel-edit hidden>Cancel edit</button></div>
      </form>
    </details>
    <form method="get" action="/" data-auto-filter class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-5">
      <input type="hidden" name="page" value="foods">
      <label class="text-sm font-medium text-slate-700">Search<input class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal" type="search" name="search" value="<%= filters.search %>" placeholder="Food name or description" data-filter-search></label>
      <label class="text-sm font-medium text-slate-700">Restaurant<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="restaurantId"><option value="">All restaurants</option><% restaurantsForSelect.forEach((restaurant) => { %><option value="<%= restaurant._id %>" <%= filters.restaurantId === String(restaurant._id) ? "selected" : "" %>><%= restaurant.name %></option><% }); %></select></label>
      <label class="text-sm font-medium text-slate-700">Availability<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="availability"><option value="">All items</option><option value="available" <%= filters.availability === "available" ? "selected" : "" %>>Available</option><option value="unavailable" <%= filters.availability === "unavailable" ? "selected" : "" %>>Unavailable</option></select></label>
      <label class="text-sm font-medium text-slate-700">Sort by<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="sort"><option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Newest</option><option value="oldest" <%= filters.sort === "oldest" ? "selected" : "" %>>Oldest</option><option value="name" <%= filters.sort === "name" ? "selected" : "" %>>Name A–Z</option><option value="price" <%= filters.sort === "price" ? "selected" : "" %>>Price low to high</option><option value="rating" <%= filters.sort === "rating" ? "selected" : "" %>>Highest rated</option></select></label>
    </form>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto">
      <table class="w-full min-w-[650px] text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Food item</th><th class="px-5 py-3">Restaurant</th><th class="px-5 py-3">Price</th><th class="px-5 py-3">Rating</th><th class="px-5 py-3">Availability</th><th class="px-5 py-3 text-right">Actions</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% if (records.length) { records.forEach((food) => { %>
            <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><% if (food.image) { %><img class="h-12 w-16 rounded-lg object-cover" src="<%= food.image %>" alt="<%= food.title %>" loading="lazy"><% } else { %><span class="flex h-12 w-16 items-center justify-center rounded-lg bg-rose-50 text-xl" aria-hidden="true">🍽️</span><% } %><div><p class="font-semibold text-slate-800"><%= food.title %></p><p class="mt-1 max-w-xs truncate text-xs text-slate-500"><%= food.description %></p></div></div></td><td class="px-5 py-4 text-slate-600"><%= food.restaurantId?.name || "Restaurant" %></td><td class="px-5 py-4 font-semibold text-slate-800">₹<%= Number(food.price).toLocaleString("en-IN") %></td><td class="px-5 py-4 text-slate-600">★ <%= Number(food.rating || 0).toFixed(1) %></td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-medium <%= food.isAvailable ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>"><%= food.isAvailable ? "Available" : "Unavailable" %></span></td><td class="px-5 py-4 text-right"><button class="font-medium text-emerald-700" type="button" data-edit-record="<%= encodeURIComponent(JSON.stringify(food)) %>">Edit</button><button class="ml-3 font-medium text-rose-600" type="button" data-delete-endpoint="/api/foods/<%= food._id %>">Delete</button></td></tr>
          <% }); } else { %><tr><td class="px-5 py-10 text-center text-slate-500" colspan="6">No food items found yet.</td></tr><% } %>
        </tbody>
      </table>
    </div></div>
  </section>
<% } %>
