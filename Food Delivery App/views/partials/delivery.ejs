<% if (typeof records === "undefined") { %>
  <article class="rounded-2xl border border-sky-100 bg-white p-5 shadow-sm"><div class="flex items-center justify-between"><span class="text-sm font-medium text-slate-500">Delivery partners</span><span class="text-lg" aria-hidden="true">🛵</span></div><p class="mt-4 text-3xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p><p class="mt-1 text-xs text-slate-500">Delivery team members</p></article>
<% } else { %>
  <section class="space-y-5">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"><p class="text-sm text-slate-500">Delivery partners</p><p class="mt-1 text-2xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p></div>
    <details class="group rounded-2xl border border-slate-200 bg-white shadow-sm">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 font-semibold text-slate-800"><span>Register delivery partner</span><span class="rounded-lg bg-emerald-700 px-3 py-2 text-sm font-semibold text-white">+ New partner</span></summary>
      <form class="grid gap-4 border-t border-slate-100 p-5 sm:grid-cols-2 lg:grid-cols-3" data-api-endpoint="/api/deliverypartners" data-edit-endpoint="/api/deliverypartners" data-entity="delivery">
        <label class="text-sm font-medium text-slate-700">Full name<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="name" required placeholder="Partner name"></label>
        <label class="text-sm font-medium text-slate-700">Email<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="email" type="email" required placeholder="partner@example.com"></label>
        <label class="text-sm font-medium text-slate-700">Phone<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="phone" type="tel" required placeholder="+91 98765 43210"></label>
        <label class="text-sm font-medium text-slate-700">Vehicle number<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="vehicleNumber" required placeholder="GJ 01 AB 1234"></label>
        <label class="text-sm font-medium text-slate-700">Vehicle type<select class="mt-1.5 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 font-normal" name="vehicleType" required><option value="">Select vehicle</option><option value="bike">Bike</option><option value="scooter">Scooter</option><option value="car">Car</option></select></label>
        <label class="text-sm font-medium text-slate-700">License number<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="licenseNumber" required placeholder="Driving license number"></label>
        <label class="text-sm font-medium text-slate-700">Status<select class="mt-1.5 w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 font-normal" name="isActive"><option value="true">Active</option><option value="false">Inactive</option></select></label>
        <label class="text-sm font-medium text-slate-700 sm:col-span-2">Profile image URL<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal" name="profileImage" type="url" placeholder="https://example.com/profile.jpg" data-image-url><img class="mt-3 hidden h-20 w-20 rounded-full border border-slate-200 object-cover" alt="Profile image preview" data-image-preview></label>
        <div class="flex gap-3 sm:col-span-2 lg:col-span-3"><button class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white" type="submit">Save partner</button><button class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700" type="button" data-cancel-edit hidden>Cancel edit</button></div>
      </form>
    </details>
    <form method="get" action="/" data-auto-filter class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-5">
      <input type="hidden" name="page" value="delivery">
      <label class="text-sm font-medium text-slate-700">Search<input class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal" type="search" name="search" value="<%= filters.search %>" placeholder="Name, email, phone" data-filter-search></label>
      <label class="text-sm font-medium text-slate-700">Vehicle type<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="vehicleType"><option value="">All vehicles</option><% ["bike", "scooter", "car"].forEach((type) => { %><option value="<%= type %>" <%= filters.vehicleType === type ? "selected" : "" %>><%= type %></option><% }); %></select></label>
      <label class="text-sm font-medium text-slate-700">Status<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="status"><option value="">All statuses</option><option value="active" <%= filters.status === "active" ? "selected" : "" %>>Active</option><option value="inactive" <%= filters.status === "inactive" ? "selected" : "" %>>Inactive</option></select></label>
      <label class="text-sm font-medium text-slate-700">Sort by<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="sort"><option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Newest</option><option value="oldest" <%= filters.sort === "oldest" ? "selected" : "" %>>Oldest</option><option value="name" <%= filters.sort === "name" ? "selected" : "" %>>Name A–Z</option><option value="vehicle" <%= filters.sort === "vehicle" ? "selected" : "" %>>Vehicle type</option></select></label>
    </form>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto">
      <table class="w-full min-w-[700px] text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Partner</th><th class="px-5 py-3">Phone</th><th class="px-5 py-3">Vehicle</th><th class="px-5 py-3">Status</th><th class="px-5 py-3 text-right">Actions</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% if (records.length) { records.forEach((partner) => { %>
            <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><% if (partner.profileImage) { %><img class="h-11 w-11 rounded-full object-cover" src="<%= partner.profileImage %>" alt="<%= partner.name %> profile" loading="lazy"><% } else { %><span class="flex h-11 w-11 items-center justify-center rounded-full bg-sky-100 font-semibold text-sky-800"><%= partner.name.charAt(0).toUpperCase() %></span><% } %><div><p class="font-semibold text-slate-800"><%= partner.name %></p><p class="mt-1 text-xs text-slate-500"><%= partner.email %></p></div></div></td><td class="px-5 py-4 text-slate-600"><%= partner.phone %></td><td class="px-5 py-4 text-slate-600"><span class="capitalize"><%= partner.vehicleType %></span> · <%= partner.vehicleNumber %></td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-medium <%= partner.isActive ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>"><%= partner.isActive ? "Active" : "Inactive" %></span></td><td class="px-5 py-4 text-right"><button class="font-medium text-emerald-700" type="button" data-edit-record="<%= encodeURIComponent(JSON.stringify(partner)) %>">Edit</button><button class="ml-3 font-medium text-rose-600" type="button" data-delete-endpoint="/api/deliverypartners/<%= partner._id %>">Delete</button></td></tr>
          <% }); } else { %><tr><td class="px-5 py-10 text-center text-slate-500" colspan="5">No delivery partners found yet.</td></tr><% } %>
        </tbody>
      </table>
    </div></div>
  </section>
<% } %>
