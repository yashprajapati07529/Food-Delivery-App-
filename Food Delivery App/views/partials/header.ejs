<header class="sticky top-0 z-20 border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <div class="flex items-center gap-2">
      <a href="/" class="flex items-center gap-2 text-orange-600">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-orange-500 text-lg text-white shadow-sm" aria-hidden="true">🍴</span>
        <span class="text-lg font-extrabold tracking-tight">FoodDelivery</span>
      </a>
      <span class="hidden rounded-md border border-orange-100 bg-orange-50 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-orange-600 sm:inline-flex">API Admin</span>
    </div>
    <nav class="order-3 flex w-full flex-wrap items-center justify-center gap-1 text-xs font-semibold text-slate-600 sm:order-none sm:w-auto sm:gap-2 sm:text-sm" aria-label="Dashboard navigation">
      <a href="/" class="rounded-lg px-2.5 py-2 transition hover:bg-orange-50 hover:text-orange-700 <%= page === 'dashboard' ? 'bg-orange-50 text-orange-700' : '' %>">◔ <span class="ml-1">Dashboard</span></a>
      <a href="/?page=customers" class="rounded-lg px-2.5 py-2 transition hover:bg-orange-50 hover:text-orange-700 <%= page === 'customers' ? 'bg-orange-50 text-orange-700' : '' %>">♟ <span class="ml-1">Customers</span></a>
      <a href="/?page=restaurants" class="rounded-lg px-2.5 py-2 transition hover:bg-orange-50 hover:text-orange-700 <%= page === 'restaurants' ? 'bg-orange-50 text-orange-700' : '' %>">▣ <span class="ml-1">Restaurants</span></a>
      <a href="/?page=foods" class="rounded-lg px-2.5 py-2 transition hover:bg-orange-50 hover:text-orange-700 <%= page === 'foods' ? 'bg-orange-50 text-orange-700' : '' %>">▤ <span class="ml-1">Foods</span></a>
      <a href="/?page=orders" class="rounded-lg px-2.5 py-2 transition hover:bg-orange-50 hover:text-orange-700 <%= page === 'orders' ? 'bg-orange-50 text-orange-700' : '' %>">▣ <span class="ml-1">Orders</span></a>
      <a href="/?page=delivery" class="rounded-lg px-2.5 py-2 transition hover:bg-orange-50 hover:text-orange-700 <%= page === 'delivery' ? 'bg-orange-50 text-orange-700' : '' %>">⚙ <span class="ml-1">Delivery</span></a>
    </nav>
    <div class="flex items-center gap-2">
      <span class="hidden rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-[11px] font-semibold text-emerald-700 sm:inline-flex" data-health-badge><span class="mr-1.5">●</span><span data-health-label>API Online</span></span>
      <button class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-[11px] font-semibold text-slate-600 transition hover:border-orange-200 hover:text-orange-700" type="button" data-health-check>⌁ Health Check</button>
      <span class="hidden max-w-36 truncate text-xs font-medium text-slate-600" data-admin-email></span>
      <button class="hidden rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50" type="button" data-admin-logout>Sign out</button>
    </div>
  </div>
</header>