<% if (typeof records === "undefined") { %>
  <article class="rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between"><span class="text-sm font-medium text-slate-500">Total customers</span><span class="text-lg" aria-hidden="true">👥</span></div>
    <p class="mt-4 text-3xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p>
    <p class="mt-1 text-xs text-emerald-700">Registered users</p>
  </article>
<% } else { %>
  <section class="space-y-5">
    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
      <div><p class="text-sm text-slate-500">Total customers</p><p class="mt-1 text-2xl font-bold text-slate-900"><%= Number(count).toLocaleString("en-IN") %></p></div>
    </div>
    <details class="group rounded-2xl border border-slate-200 bg-white shadow-sm">
      <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 font-semibold text-slate-800"><span>Add customer</span><span class="rounded-lg bg-emerald-700 px-3 py-2 text-sm font-semibold text-white">+ New customer</span></summary>
      <form class="grid gap-4 border-t border-slate-100 p-5 sm:grid-cols-2 lg:grid-cols-3" data-api-endpoint="/api/customers/register" data-edit-endpoint="/api/customers/admin" data-entity="customer">
        <label class="text-sm font-medium text-slate-700">Full name<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal outline-none focus:border-emerald-600" name="name" required placeholder="Customer name"></label>
        <label class="text-sm font-medium text-slate-700">Email<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal outline-none focus:border-emerald-600" name="email" type="email" required placeholder="name@example.com"></label>
        <label class="text-sm font-medium text-slate-700">Password<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal outline-none focus:border-emerald-600" name="password" type="password" minlength="6" required placeholder="At least 6 characters"></label>
        <label class="text-sm font-medium text-slate-700">Phone<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal outline-none focus:border-emerald-600" name="phone" type="tel" required placeholder="+91 98765 43210"></label>
        <label class="text-sm font-medium text-slate-700">City<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal outline-none focus:border-emerald-600" name="city" required placeholder="City"></label>
        <label class="text-sm font-medium text-slate-700 sm:col-span-2 lg:col-span-1">Address<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal outline-none focus:border-emerald-600" name="address" required placeholder="Delivery address"></label>
        <label class="text-sm font-medium text-slate-700 sm:col-span-2 lg:col-span-3">Profile image URL<input class="mt-1.5 w-full rounded-lg border border-slate-200 px-3 py-2.5 font-normal outline-none focus:border-emerald-600" name="profileImage" type="url" placeholder="https://example.com/profile.jpg" data-image-url><img class="mt-3 hidden h-20 w-20 rounded-full border border-slate-200 object-cover" alt="Profile image preview" data-image-preview></label>
        <div class="flex gap-3 sm:col-span-2 lg:col-span-3"><button class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-semibold text-white" type="submit">Save customer</button><button class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700" type="button" data-cancel-edit hidden>Cancel edit</button></div>
      </form>
    </details>
    <form method="get" action="/" data-auto-filter class="grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-4">
      <input type="hidden" name="page" value="customers">
      <label class="text-sm font-medium text-slate-700">Search<input class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal" type="search" name="search" value="<%= filters.search %>" placeholder="Name, email, phone" data-filter-search></label>
      <label class="text-sm font-medium text-slate-700">City filter<input class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 font-normal" name="city" value="<%= filters.city %>" placeholder="City"></label>
      <label class="text-sm font-medium text-slate-700">Sort by<select class="mt-1 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 font-normal" name="sort"><option value="newest" <%= filters.sort === "newest" ? "selected" : "" %>>Newest</option><option value="oldest" <%= filters.sort === "oldest" ? "selected" : "" %>>Oldest</option><option value="name" <%= filters.sort === "name" ? "selected" : "" %>>Name A–Z</option><option value="city" <%= filters.sort === "city" ? "selected" : "" %>>City A–Z</option></select></label>
    </form>
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full min-w-[700px] text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Customer</th><th class="px-5 py-3">Phone</th><th class="px-5 py-3">City</th><th class="px-5 py-3">Joined</th><th class="px-5 py-3 text-right">Actions</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            <% if (records.length) { records.forEach((customer) => { %>
              <tr><td class="px-5 py-4"><div class="flex items-center gap-3"><% if (customer.profileImage) { %><img class="h-11 w-11 rounded-full object-cover" src="<%= customer.profileImage %>" alt="<%= customer.name %> profile" loading="lazy"><% } else { %><span class="flex h-11 w-11 items-center justify-center rounded-full bg-emerald-100 font-semibold text-emerald-800"><%= customer.name.charAt(0).toUpperCase() %></span><% } %><div><p class="font-semibold text-slate-800"><%= customer.name %></p><p class="mt-1 text-xs text-slate-500"><%= customer.email %></p></div></div></td><td class="px-5 py-4 text-slate-600"><%= customer.phone %></td><td class="px-5 py-4 text-slate-600"><%= customer.city %></td><td class="px-5 py-4 text-slate-500"><%= new Date(customer.createdAt).toLocaleDateString("en-IN") %></td><td class="px-5 py-4 text-right"><button class="font-medium text-emerald-700" type="button" data-edit-record="<%= encodeURIComponent(JSON.stringify(customer)) %>">Edit</button><button class="ml-3 font-medium text-rose-600" type="button" data-delete-endpoint="/api/customers/admin/<%= customer._id %>">Delete</button></td></tr>
            <% }); } else { %><tr><td class="px-5 py-10 text-center text-slate-500" colspan="5">No customers found yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
<% } %>